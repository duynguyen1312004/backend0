<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Projects - TaskFlow</title>

    <link rel="stylesheet" href="/css/projects.css" />
  </head>

  <body>
    <div class="app-layout">
      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-icon">✓</div>
          <span>TaskFlow</span>
        </div>

        <nav class="sidebar-nav">
          <a href="/" class="nav-item">
            <span class="nav-icon">⌂</span>
            Dashboard
          </a>

          <a href="/projects" class="nav-item active">
            <span class="nav-icon">▦</span>
            Projects
          </a>

          <a href="/create" class="nav-item">
            <span class="nav-icon">＋</span>
            Create User
          </a>
        </nav>

        <div class="sidebar-bottom">
          <a href="/" class="back-link">
            ← Back to Dashboard
          </a>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="main-content">
        <header class="page-header">
          <div>
            <p class="page-label">WORKSPACE</p>
            <h1>Projects</h1>
            <p class="page-description">
              Manage and track all your projects in one place.
            </p>
          </div>

          <a href="/" class="dashboard-btn">
            ← Dashboard
          </a>
        </header>

        <!-- Project Summary -->
        <section class="summary-card">
          <div class="summary-icon">▦</div>

          <div>
            <p class="summary-title">Total Projects</p>
            <h2><%= listProjects.length %></h2>
          </div>
        </section>

        <!-- Projects -->
        <section class="projects-section">
          <div class="section-heading">
            <h2>All Projects</h2>
            <span class="project-count">
              <%= listProjects.length %> projects
            </span>
          </div>

          <% if (listProjects.length === 0) { %>
            <div class="empty-state">
              <div class="empty-icon">▦</div>
              <h3>No projects yet</h3>
              <p>
                Your projects will appear here when you create them.
              </p>

              <a href="/" class="empty-btn">
                Back to Dashboard
              </a>
            </div>
          <% } else { %>
            <div class="project-grid">
              <% listProjects.forEach((project) => { %>
                <article class="project-card">
                  <div class="project-card-top">
                    <span class="project-badge">
                      Project
                    </span>

                    <button class="more-btn" type="button">
                      ⋯
                    </button>
                  </div>

                  <div class="project-content">
                    <h3>
                      <%= project.name %>
                    </h3>

                    <p class="project-description">
                      <%= project.description || "No description available." %>
                    </p>
                  </div>

                  <div class="project-dates">
                    <div class="date-item">
                      <span class="date-label">Start date</span>
                      <span class="date-value">
                        <%= project.startDate || "Not set" %>
                      </span>
                    </div>

                    <div class="date-item">
                      <span class="date-label">End date</span>
                      <span class="date-value">
                        <%= project.endDate || "Not set" %>
                      </span>
                    </div>
                  </div>

                  <div class="project-footer">
                    <a href="/projects/<%= project._id %>">
                      View Project
                      <span>→</span>
                    </a>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>
      </main>
    </div>
  </body>
</html>