<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Delete User - TaskFlow</title>

    <link rel="stylesheet" href="/css/delete-user.css" />
  </head>

  <body>
    <div class="page-container">
      <div class="delete-card">
        <!-- Warning Icon -->
        <div class="warning-icon">!</div>

        <!-- Title -->
        <h1>Delete User?</h1>

        <p class="warning-text">
          Are you sure you want to delete this user? This action cannot be
          undone.
        </p>

        <!-- User Information -->
        <div class="user-info">
          <div class="info-row">
            <span class="label">Name</span>
            <span class="value"> <%= userEdit.name %> </span>
          </div>

          <div class="info-row">
            <span class="label">Email</span>
            <span class="value"> <%= userEdit.email %> </span>
          </div>

          <div class="info-row">
            <span class="label">City</span>
            <span class="value"> <%= userEdit.city || "N/A" %> </span>
          </div>
        </div>

        <!-- Action -->
        <form action="/delete-user" method="POST">
          <input type="hidden" name="userId" value="<%= userEdit._id %>" />

          <div class="actions">
            <a href="/" class="btn btn-cancel"> Cancel </a>

            <button type="submit" class="btn btn-delete">Confirm Delete</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
