<!DOCTYPE html>
<html>
  <head>
    <title>Updated A User</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>

  <body>
    <h1>Hello EJS!</h1>

    <div class="topnav">
      <a href="/">Home</a>
      <a href="/create">Create Users</a>
    </div>
    <div class="form">
      <form action="/update-user" method="POST">
        <fieldset>
          <legend>Update new users</legend>

          <div class="input-group d-none">
            <label for="userId">Id:</label>
            <input
              type="text"
              id="userId"
              name="userId"
              value="<%= userEdit.id %>"
            />
          </div>

          <div class="input-group">
            <label for="email">Email:</label>
            <input
              type="text"
              id="emailId"
              name="email"
              value="<%= userEdit.email %>"
            />
          </div>

          <div class="input-group">
            <label for="name">Name:</label>
            <input
              type="text"
              id="nameId"
              name="name"
              value="<%= userEdit.name %>"
            />
          </div>

          <div class="input-group">
            <label for="city">City:</label>
            <input
              type="text"
              id="city"
              name="city"
              value="<%= userEdit.city %>"
            />
          </div>

          <div class="input-group">
            <button type="submit">Save</button>
          </div>
        </fieldset>
      </form>
    </div>

    <div>
      <img src="/images/duy.jpg" alt="Duy" />
    </div>
  </body>
</html>
