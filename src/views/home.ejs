
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Dashboard - TaskFlow</title>

    <link rel="stylesheet" href="/css/styles.css" />
  </head>

  <body>

    <div class="dashboard-layout">

      <!-- SIDEBAR -->
      <aside class="sidebar">

        <div class="sidebar-top">

          <!-- LOGO -->
          <div class="brand">
            <div class="brand-icon">✓</div>
            <span>TaskFlow</span>
          </div>


          <!-- WORKSPACE -->
          <div class="workspace-switcher">
            <div class="workspace-avatar">T</div>

            <div class="workspace-info">
              <strong>My Workspace</strong>
              <span>Personal workspace</span>
            </div>

            <span class="workspace-arrow">⌄</span>
          </div>


          <!-- NAVIGATION -->
          <nav class="sidebar-nav">

            <p class="nav-label">WORKSPACE</p>

            <a href="/" class="nav-item active">
              <span class="nav-icon">▦</span>
              Dashboard
            </a>

            <a href="/projects" class="nav-item">
              <span class="nav-icon">▣</span>
              Projects
            </a>

            <a href="#" class="nav-item">
              <span class="nav-icon">☑</span>
              My Tasks
            </a>

            <a href="#" class="nav-item">
              <span class="nav-icon">♧</span>
              Team
            </a>


            <p class="nav-label nav-label-spaced">
              MANAGE
            </p>

            <a href="/create" class="nav-item">
              <span class="nav-icon">＋</span>
              Create Users
            </a>

          </nav>

        </div>


        <!-- SIDEBAR FOOTER -->
        <div class="sidebar-footer">

          <div class="sidebar-help">
            <span class="help-icon">?</span>

            <div>
              <strong>Need help?</strong>
              <span>We're here for you.</span>
            </div>
          </div>

          <div class="sidebar-profile">

            <div class="profile-avatar">D</div>

            <div class="profile-info">
              <strong>Duy Nguyen</strong>
              <span>Administrator</span>
            </div>

            <span class="profile-more">•••</span>

          </div>

        </div>

      </aside>


      <!-- MAIN CONTENT -->
      <main class="main-content">

        <!-- TOP HEADER -->
        <header class="top-header">

          <div class="header-title">
            <p class="page-eyebrow">OVERVIEW</p>

            <h1>Good morning, Duy <span>👋</span></h1>

            <p>
              Here's what's happening with your workspace.
            </p>
          </div>


          <div class="header-actions">

            <button class="notification-button" type="button">
              ♧
              <span class="notification-dot"></span>
            </button>

            <div class="header-user">
              <div class="header-avatar">D</div>

              <div>
                <strong>Duy Nguyen</strong>
                <span>Administrator</span>
              </div>
            </div>

          </div>

        </header>


        <!-- STATISTICS -->
        <section class="stats-grid">

          <div class="stat-card">

            <div class="stat-card-top">
              <span class="stat-label">TOTAL USERS</span>
              <div class="stat-icon green">♧</div>
            </div>

            <div class="stat-number">
              <%= listUsers.length %>
            </div>

            <p class="stat-description">
              Registered accounts
            </p>

          </div>


          <div class="stat-card">

            <div class="stat-card-top">
              <span class="stat-label">PROJECTS</span>
              <div class="stat-icon purple">▣</div>
            </div>

            <div class="stat-number">
              <%= listProjects.length %>
            </div>

            <p class="stat-description">
              Active projects
            </p>

          </div>


          <div class="stat-card">

            <div class="stat-card-top">
              <span class="stat-label">TASKS</span>
              <div class="stat-icon orange">☑</div>
            </div>

            <div class="stat-number">
              <%= listTasks.length %>
            </div>

            <p class="stat-description">
              Tasks in progress
            </p>

          </div>


          <div class="stat-card">

            <div class="stat-card-top">
              <span class="stat-label">COMPLETED</span>
              <div class="stat-icon blue">✓</div>
            </div>

            <div class="stat-number">
              86%
            </div>

            <p class="stat-description">
              Overall completion
            </p>

          </div>

        </section>


        <!-- CONTENT GRID -->
        <section class="content-grid">


          <!-- USERS TABLE -->
          <div class="table-card">

            <div class="table-card-header">

              <div>
                <p class="section-eyebrow">WORKSPACE</p>

                <h2>List Users</h2>

                <p>
                  Manage all registered accounts.
                </p>
              </div>

              <a href="/create" class="primary-button">
                <span>＋</span>
                Create User
              </a>

            </div>


            <!-- SEARCH / FILTER -->
            <div class="table-toolbar">

              <div class="search-box">
                <span>⌕</span>

                <input
                  type="text"
                  id="userSearch"
                  placeholder="Search users..."
                />
              </div>

              <span class="user-count">
                <%= listUsers.length %> users
              </span>

            </div>


            <!-- TABLE -->
            <div class="table-container">

              <table>

                <thead>
                  <tr>
                    <th>USER</th>
                    <th>EMAIL</th>
                    <th>CITY</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                  </tr>
                </thead>

                <tbody id="userTableBody">

                  <% listUsers.forEach((user) => { %>

                    <tr>

                      <td>
                        <div class="user-cell">

                          <div class="user-avatar">
                            <%= user.name.charAt(0).toUpperCase() %>
                          </div>

                          <div class="user-cell-info">
                            <strong>
                              <%= user.name %>
                            </strong>

                            <span>
                              ID #<%= user.id %>
                            </span>
                          </div>

                        </div>
                      </td>


                      <td>
                        <span class="email-text">
                          <%= user.email %>
                        </span>
                      </td>


                      <td>
                        <span class="city-text">
                          <%= user.city %>
                        </span>
                      </td>


                      <td>
                        <span class="status-badge">
                          <span class="status-dot"></span>
                          Active
                        </span>
                      </td>


                      <td>

                        <div class="action-buttons">

                          <a
                            href="/update/<%= user.id %>"
                            class="action-button edit"
                          >
                            Edit
                          </a>


                          <form
                            action="/delete-user/<%= user.id %>"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this user?')"
                          >

                            <button
                              type="submit"
                              class="action-button delete"
                            >
                              Delete
                            </button>

                          </form>

                        </div>

                      </td>

                    </tr>

                  <% }); %>

                </tbody>

              </table>

            </div>


            <!-- TABLE FOOTER -->
            <div class="table-footer">

              <span>
                Showing <%= listUsers.length %> users
              </span>

              <span class="footer-note">
                Manage your workspace accounts
              </span>

            </div>

          </div>


          <!-- RIGHT SIDE CARD -->
          <aside class="profile-card">

            <div class="profile-card-header">
              <span class="section-eyebrow">YOUR PROFILE</span>
              <span class="profile-status">● Active</span>
            </div>


            <div class="profile-card-body">

              <div class="large-avatar">D</div>

              <h3>Duy Nguyen</h3>

              <p>Administrator</p>

              <div class="profile-divider"></div>

              <div class="profile-detail">
                <span>Email</span>
                <strong>duy@example.com</strong>
              </div>

              <div class="profile-detail">
                <span>Workspace</span>
                <strong>My Workspace</strong>
              </div>

              <div class="profile-detail">
                <span>Member since</span>
                <strong>2026</strong>
              </div>

            </div>

          </aside>

        </section>


        <!-- FOOTER -->
        <footer class="dashboard-footer">
          © 2026 TaskFlow. Built for better productivity.
        </footer>

      </main>

    </div>


    <!-- SEARCH USERS -->
    <script>
      const searchInput = document.getElementById("userSearch");
      const tableBody = document.getElementById("userTableBody");

      searchInput.addEventListener("input", function () {
        const keyword = this.value.toLowerCase().trim();

        const rows = tableBody.querySelectorAll("tr");

        rows.forEach((row) => {
          const text = row.textContent.toLowerCase();

          row.style.display = text.includes(keyword)
            ? ""
            : "none";
        });
      });
    </script>

  </body>
</html>