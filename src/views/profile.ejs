<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Profile - TaskFlow</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f5f7fb;
        color: #1f2937;
      }

      .profile-container {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 60px 20px;
      }

      .profile-card {
        width: 100%;
        max-width: 700px;
        background: white;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
      }

      .profile-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding-bottom: 30px;
        border-bottom: 1px solid #e5e7eb;
      }

      .profile-avatar {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #2563eb;
        color: white;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 30px;
        font-weight: 600;
        flex-shrink: 0;
      }

      .profile-header h1 {
        margin: 0 0 8px;
        font-size: 26px;
      }

      .profile-header p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
      }

      .profile-info {
        margin-top: 25px;
      }

      .profile-item {
        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 17px 0;
        border-bottom: 1px solid #f0f0f0;
      }

      .label {
        color: #6b7280;
        font-size: 14px;
      }

      .value {
        font-weight: 500;
        color: #111827;
      }

      .profile-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 10px 18px;
        border-radius: 8px;

        text-decoration: none;
        font-size: 14px;
        font-weight: 500;

        transition: 0.2s;
      }

      .btn-secondary {
        background: #f3f4f6;
        color: #374151;
      }

      .btn-secondary:hover {
        background: #e5e7eb;
      }

      .btn-primary {
        background: #2563eb;
        color: white;
      }

      .btn-primary:hover {
        background: #1d4ed8;
      }

      @media (max-width: 600px) {
        .profile-container {
          padding: 30px 15px;
        }

        .profile-card {
          padding: 25px 20px;
        }

        .profile-header {
          gap: 15px;
        }

        .profile-avatar {
          width: 60px;
          height: 60px;
          font-size: 24px;
        }

        .profile-header h1 {
          font-size: 21px;
        }

        .profile-item {
          align-items: flex-start;
          flex-direction: column;
          gap: 5px;
        }

        .profile-actions {
          justify-content: stretch;
        }

        .btn {
          flex: 1;
        }
      }
    </style>
  </head>

  <body>
    <div class="profile-container">
      <div class="profile-card">
        <!-- Profile Header -->
        <div class="profile-header">
          <div class="profile-avatar">
            <%= currentUser.name.charAt(0).toUpperCase() %>
          </div>

          <div>
            <h1><%= currentUser.name %></h1>

            <p><%= currentUser.email %></p>
          </div>
        </div>

        <!-- Profile Information -->
        <div class="profile-info">
          <div class="profile-item">
            <span class="label">Name</span>

            <span class="value"> <%= currentUser.name %> </span>
          </div>

          <div class="profile-item">
            <span class="label">Email</span>

            <span class="value"> <%= currentUser.email %> </span>
          </div>

          <div class="profile-item">
            <span class="label">City</span>

            <span class="value">
              <%= currentUser.city || "Not updated" %>
            </span>
          </div>

          <div class="profile-item">
            <span class="label">Role</span>

            <span class="value"> <%= currentUser.role %> </span>
          </div>
        </div>

        <!-- Actions -->
        <div class="profile-actions">
          <a href="/" class="btn btn-secondary"> ← Back </a>

          <a href="/profile/edit" class="btn btn-primary"> Edit Profile </a>
        </div>
      </div>
    </div>
  </body>
</html>
