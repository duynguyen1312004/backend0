<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - TaskFlow</title>

    <link rel="stylesheet" href="/css/auth.css" />
  </head>

  <body>
    <main class="auth-container">
      <!-- LEFT SIDE -->
      <section class="auth-banner">
        <header class="brand">
          <div class="brand-icon">✓</div>
          <span>TaskFlow</span>
        </header>

        <div class="banner-content">
          <span class="badge">WELCOME TO TASKFLOW</span>

          <h1>
            Organize your work,
            <br />
            achieve more <span>together.</span>
          </h1>

          <p>
            Plan, track and manage your projects with ease. Work better,
            together.
          </p>

          <div class="feature-list">
            <div class="feature">
              <div class="feature-icon">✓</div>

              <div>
                <strong>Manage Projects</strong>
                <span> Keep your projects organized and on track. </span>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">👥</div>

              <div>
                <strong>Collaborate</strong>
                <span> Work together with your team. </span>
              </div>
            </div>

            <div class="feature">
              <div class="feature-icon">⚡</div>

              <div>
                <strong>Stay Productive</strong>
                <span> Focus on what matters most. </span>
              </div>
            </div>
          </div>
        </div>

        <footer class="banner-footer">
          © 2026 TaskFlow. Built for better productivity.
        </footer>
      </section>

      <!-- RIGHT SIDE -->
      <section class="auth-form-wrapper">
        <div class="auth-form">
          <!-- FORM BRAND -->
          <div class="mobile-brand">
            <div class="brand-icon">✓</div>
            <span>TaskFlow</span>
          </div>

          <!-- HEADER -->
          <div class="form-header">
            <span class="form-eyebrow">WELCOME BACK</span>

            <h2>Welcome back</h2>

            <p>Login to your account to continue.</p>
          </div>

          <!-- LOGIN FORM -->
          <form action="/login" method="POST">
            <!-- EMAIL -->
            <div class="form-group">
              <label for="email">Email address</label>

              <div class="input-wrapper">
                <span class="input-icon">✉</span>

                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="you@example.com"
                  autocomplete="email"
                  required
                />
              </div>
            </div>

            <!-- PASSWORD -->
            <div class="form-group">
              <label for="password">Password</label>

              <div class="input-wrapper">
                <span class="input-icon">🔒</span>

                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  autocomplete="current-password"
                  required
                />
              </div>
            </div>

            <!-- OPTIONS -->
            <div class="form-options">
              <label class="remember">
                <input type="checkbox" name="remember" />

                <span>Remember me</span>
              </label>

              <a href="/forgot-password"> Forgot password? </a>
            </div>

            <!-- LOGIN BUTTON -->
            <button type="submit" class="auth-button">
              Log in
              <span>→</span>
            </button>
          </form>

          <!-- DIVIDER -->
          <div class="divider">
            <span>or continue with</span>
          </div>

          <!-- GOOGLE -->
          <button class="google-button" type="button">
            <span class="google-icon">G</span>
            Continue with Google
          </button>

          <!-- REGISTER -->
          <p class="form-footer register-link">
            Don't have an account?
            <a href="/register">Register</a>
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
