<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>Create Task - TaskFlow</title>

    <link rel="stylesheet" href="/css/task-form.css" />
  </head>

  <body>
    <div class="app-layout">

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="brand">
          <div class="brand-icon">✓</div>
          <span>TaskFlow</span>
        </div>

        <nav class="sidebar-nav">
          <a href="/" class="nav-item">
            <span class="nav-icon">⌂</span>
            Dashboard
          </a>

          <a href="/projects" class="nav-item active">
            <span class="nav-icon">▦</span>
            Projects
          </a>

          <a href="/create" class="nav-item">
            <span class="nav-icon">＋</span>
            Create User
          </a>
        </nav>

        <div class="sidebar-bottom">
          <a
            href="/projects/<%= projectId %>"
            class="back-link"
          >
            ← Back to Project
          </a>
        </div>
      </aside>


      <!-- Main Content -->
      <main class="main-content">

        <!-- Header -->
        <header class="page-header">
          <div>
            <p class="page-label">TASK MANAGEMENT</p>

            <h1>Create Task</h1>

            <p class="page-description">
              Add a new task to your project and assign it to a member.
            </p>
          </div>

          <a
            href="/projects/<%= projectId %>"
            class="back-button"
          >
            ← Back to Project
          </a>
        </header>


        <!-- Form Card -->
        <section class="form-card">

          <div class="form-card-header">
            <div class="form-icon">✓</div>

            <div>
              <h2>Task Information</h2>

              <p>
                Fill in the details below to create a new task.
              </p>
            </div>
          </div>


          <form
            action="/projects/<%= projectId %>/tasks/create"
            method="POST"
          >

            <!-- Task Name -->
            <div class="input-group">
              <label for="taskName">
                Task Name
                <span>*</span>
              </label>

              <input
                type="text"
                id="taskName"
                name="name"
                placeholder="Enter task name"
                required
              />
            </div>


            <!-- Description -->
            <div class="input-group">
              <label for="description">
                Description
              </label>

              <textarea
                id="description"
                name="description"
                rows="5"
                placeholder="Describe what needs to be done..."
              ></textarea>
            </div>


            <!-- Status -->
            <div class="input-group">
              <label for="status">
                Status
              </label>

              <select id="status" name="status">
                <option value="TODO">TODO</option>
                <option value="IN_PROGRESS">
                  IN_PROGRESS
                </option>
                <option value="DONE">DONE</option>
              </select>
            </div>


            <!-- Dates -->
            <div class="date-grid">

              <div class="input-group">
                <label for="startDate">
                  Start Date
                </label>

                <input
                  type="date"
                  id="startDate"
                  name="startDate"
                />
              </div>

              <div class="input-group">
                <label for="endDate">
                  End Date
                </label>

                <input
                  type="date"
                  id="endDate"
                  name="endDate"
                />
              </div>

            </div>


            <!-- Assigned Member -->
            <div class="input-group">
              <label for="assignedTo">
                Assigned To
              </label>

              <select id="assignedTo" name="assignedTo">
                <option value="">
                  -- Select member --
                </option>

                <% users.forEach((user) => { %>
                  <option value="<%= user._id %>">
                    <%= user.name %> - <%= user.email %>
                  </option>
                <% }) %>
              </select>
            </div>


            <!-- Actions -->
            <div class="form-actions">
              <a
                href="/projects/<%= projectId %>"
                class="btn btn-cancel"
              >
                Cancel
              </a>

              <button
                type="submit"
                class="btn btn-submit"
              >
                Create Task
              </button>
            </div>

          </form>
        </section>

      </main>
    </div>
  </body>
</html>